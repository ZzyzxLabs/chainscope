# chainscope configuration
#
#   cp .env.example .env    then fill in what you need
#
# Everything here is optional. chainscope loads the environment first and this
# file second, so CI and container runtimes override it without special cases.
# Nothing fails at import for a missing key --- it fails at the moment something
# needs it, naming the variable and where to get one.
#
# `chainscope doctor` reports what is configured and what each key unlocks.
# `.env` is gitignored. Keep it that way.


# ---------------------------------------------------------------- explorers
# The one that matters most. No JSON-RPC method lists an address's transactions,
# so without an explorer-class key the question "what did this address do" has
# no answer and every traversal built on it is unreachable.
#
# One Etherscan V2 key covers 60+ EVM chains. Free.
#   https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional. Bitcoin address history without running a node.
#   https://blockchair.com/api
BLOCKCHAIR_API_KEY=


# ---------------------------------------------------------------- RPC access
# Balances, code, receipts, logs. Public endpoints work for light use; a keyed
# one is worth having before any traversal wider than a few dozen addresses.
#   https://alchemy.com   https://helius.dev   https://trongrid.io
ALCHEMY_API_KEY=
HELIUS_API_KEY=
TRONGRID_API_KEY=

# Per-chain endpoints, named CHAINSCOPE_RPC_<CHAIN>. The chain part is the short
# name uppercased; CAIP-2 identifiers such as eip155:1 are not legal variable
# names. Add any chain you have an endpoint for --- these are read by name, not
# from a fixed list.
#
# A key embedded in the URL path is handled: it is registered with the scrubber
# on load, so it cannot reach an audit log, a cache key, or a cassette.
CHAINSCOPE_RPC_ETHEREUM=
CHAINSCOPE_RPC_BSC=
CHAINSCOPE_RPC_POLYGON=
CHAINSCOPE_RPC_ARBITRUM=
CHAINSCOPE_RPC_BASE=
CHAINSCOPE_RPC_SOLANA=


# ---------------------------------------------------------------- behaviour
# Where cached responses live. This directory is the reproducibility mechanism,
# not a performance detail: cache keys carry no credential, so a populated cache
# replays on someone else's machine with no API keys and no network. That is
# what a case bundle ships.
CHAINSCOPE_CACHE_DIR=.chainscope/cache

# Append-only JSONL record of every outbound query. An investigation whose
# queries were not recorded cannot be defended. Unset means no log.
CHAINSCOPE_AUDIT_LOG=

# Requests per second per host, and per-request timeout in seconds.
CHAINSCOPE_RATE_LIMIT=5
CHAINSCOPE_TIMEOUT=30
