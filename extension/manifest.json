{
  "manifest_version": 3,
  "name": "chainscope",
  "version": "0.1.0",
  "description": "Show what your chainscope store knows about the addresses on a page, and label them without leaving it.",

  "permissions": ["storage"],

  "host_permissions": ["http://127.0.0.1/*"],

  "content_scripts": [
    {
      "matches": [
        "https://etherscan.io/*",
        "https://bscscan.com/*",
        "https://polygonscan.com/*",
        "https://arbiscan.io/*",
        "https://basescan.org/*",
        "https://optimistic.etherscan.io/*",
        "https://snowtrace.io/*",
        "https://suiscan.xyz/*",
        "https://suivision.xyz/*",
        "https://tronscan.org/*",
        "https://mempool.space/*",
        "https://blockchair.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "chainscope" }
}
